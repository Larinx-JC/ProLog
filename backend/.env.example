# Copy to .env and fill in real values for your machine. Never commit .env.
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=mysql+pymysql://prolog:prolog@localhost:3306/prolog
CORS_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:5173
# Production: set APP_ENV=production, HTTPS origins, a random 32+ character
# SECRET_KEY, and SECURE_COOKIES=true. Development HTTP is local only.
SECURE_COOKIES=false
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=43200
ACTIVATION_SECONDS=86400
RECOVERY_SECONDS=1800
AUTH_WINDOW_SECONDS=900
LOGIN_ACCOUNT_LIMIT=5
LOGIN_ADDRESS_LIMIT=30
GRANT_ADDRESS_LIMIT=20
